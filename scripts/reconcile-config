#!/usr/bin/env python3
"""Render read-only agent-config generations and link them into Codex."""

import argparse
import filecmp
import hashlib
import json
import os
import re
import shutil
import stat
import string
import sys
import tempfile
import time
from dataclasses import dataclass, field
from datetime import date
from pathlib import Path
from urllib.parse import unquote

LAYER_PATTERN = re.compile(r"^\d+-[A-Za-z0-9][A-Za-z0-9._-]*$")
GENERATION_PATTERN = re.compile(r"^(\d{4}-\d{2}-\d{2})__(\d{2,})$")
NAME_PATTERN = re.compile(r"^name\s*:\s*(['\"]?)([^'\"\s#]+)\1\s*(?:#.*)?$")
DESCRIPTION_PATTERN = re.compile(r"^description\s*:\s*\S")
MANAGED_MARKER = "<!-- generated: agent-config; do not edit -->"
RESOURCES_PLACEHOLDER = "{{%_resources_%}}"
SKILLS_PLACEHOLDER = "{{%_skills_%}}"
AGENTS_PLACEHOLDER = "{{%_agents_%}}"
GUIDANCE_SKILL = Path("skills/Agent_Guidance/SKILL.md")
GENERATION_RETENTION = 5


class ReconcileError(Exception):
    """A configuration error that must be fixed before rendering or syncing."""


@dataclass(frozen=True)
class RenderPlan:
    layers: list[Path]
    skills: dict[str, Path]
    resources: dict[Path, Path]
    skill_overrides: list[tuple[str, Path, Path]]
    resource_overrides: list[tuple[Path, Path, Path]]
    agents: str
    fragment_count: int
    directories: set[Path]
    files: dict[Path, Path]
    contents: dict[Path, bytes]


@dataclass(frozen=True)
class Generation:
    ordinal: int
    path: Path


@dataclass
class LinkPlan:
    directory: Path
    component: str
    removals: list[Path] = field(default_factory=list)
    links: list[tuple[Path, Path]] = field(default_factory=list)
    unchanged: int = 0


@dataclass(frozen=True)
class AgentsLinkPlan:
    destination: Path
    source: Path
    remove_existing: bool
    unchanged: bool


def absolute_path(path: Path) -> Path:
    """Normalize a path without following a source or destination symlink."""

    return Path(os.path.abspath(os.fspath(path.expanduser())))


def read_skill_name(skill_file: Path) -> str:
    try:
        lines = skill_file.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise ReconcileError(f"cannot read skill: {skill_file}: {error}") from error

    if not lines or lines[0].strip() != "---":
        raise ReconcileError(f"skill has no YAML frontmatter: {skill_file}")

    frontmatter: list[str] = []
    for line in lines[1:]:
        if line.strip() in {"---", "..."}:
            break
        frontmatter.append(line)
    else:
        raise ReconcileError(f"skill has unterminated YAML frontmatter: {skill_file}")

    name: str | None = None
    has_description = False
    for line in frontmatter:
        match = NAME_PATTERN.fullmatch(line)
        if match:
            if name is not None:
                raise ReconcileError(f"skill has duplicate frontmatter names: {skill_file}")
            name = match.group(2)
        if DESCRIPTION_PATTERN.match(line):
            has_description = True

    if name is None:
        raise ReconcileError(f"skill has no frontmatter name: {skill_file}")
    if not has_description:
        raise ReconcileError(f"skill has no frontmatter description: {skill_file}")
    if name != skill_file.parent.name:
        raise ReconcileError(
            f"skill name {name!r} does not match directory {skill_file.parent.name!r}: {skill_file}"
        )
    return name


def discover_layers(config_dir: Path) -> list[Path]:
    if not config_dir.is_dir():
        raise ReconcileError(f"missing agent-config directory: {config_dir}")

    sections_root = config_dir / "sections"
    if sections_root.is_symlink():
        raise ReconcileError(f"symlinked source sections are not supported: {sections_root}")
    if not sections_root.exists():
        raise ReconcileError(f"missing agent-config sections directory: {sections_root}")
    if not sections_root.is_dir():
        raise ReconcileError(f"agent-config sections path is not a directory: {sections_root}")

    layers: list[Path] = []
    for entry in sections_root.iterdir():
        if not LAYER_PATTERN.fullmatch(entry.name):
            continue
        if entry.is_symlink():
            raise ReconcileError(f"symlinked source layers are not supported: {entry}")
        if entry.is_dir():
            layers.append(entry)
    return sorted(layers, key=lambda entry: entry.name)


def discover_skills(layers: list[Path]) -> tuple[dict[str, Path], list[tuple[str, Path, Path]]]:
    desired: dict[str, Path] = {}
    overrides: list[tuple[str, Path, Path]] = []

    for layer in layers:
        skills_root = layer / "skills"
        if not skills_root.exists():
            continue
        if skills_root.is_symlink() or not skills_root.is_dir():
            raise ReconcileError(f"skill root is not a regular directory: {skills_root}")

        for entry in sorted(skills_root.iterdir(), key=lambda item: item.name):
            if entry.name.startswith("."):
                continue
            if entry.is_symlink():
                raise ReconcileError(f"symlinked skill directories are not supported: {entry}")
            if not entry.is_dir():
                continue
            skill_file = entry / "SKILL.md"
            if not skill_file.is_file() or skill_file.is_symlink():
                if (
                    not skill_file.exists()
                    and not skill_file.is_symlink()
                    and all(child.is_dir() and not child.is_symlink() for child in entry.rglob("*"))
                ):
                    continue
                raise ReconcileError(f"skill directory has no regular SKILL.md: {entry}")
            name = read_skill_name(skill_file)
            source = absolute_path(entry)
            if name in desired:
                overrides.append((name, desired[name], source))
            desired[name] = source

    return desired, overrides


def discover_resources(
    layers: list[Path],
) -> tuple[dict[Path, Path], list[tuple[Path, Path, Path]]]:
    desired: dict[Path, Path] = {}
    overrides: list[tuple[Path, Path, Path]] = []

    for layer in layers:
        resources_root = layer / "resources"
        if not resources_root.exists():
            continue
        if resources_root.is_symlink() or not resources_root.is_dir():
            raise ReconcileError(f"resource root is not a regular directory: {resources_root}")

        for entry in sorted(
            resources_root.rglob("*"),
            key=lambda item: item.relative_to(resources_root).as_posix(),
        ):
            if entry.is_symlink():
                raise ReconcileError(f"symlinked resources are not supported: {entry}")
            if entry.is_dir():
                continue
            if not entry.is_file():
                raise ReconcileError(f"resource is not a regular file: {entry}")

            relative = entry.relative_to(resources_root)
            if relative.parts[0] == "references":
                raise ReconcileError(
                    f"place grouped resources directly under resources, "
                    f"without a references directory: {entry}"
                )
            source = absolute_path(entry)
            conflicts = [
                previous
                for previous in desired
                if relative == previous
                or relative.is_relative_to(previous)
                or previous.is_relative_to(relative)
            ]
            for previous in conflicts:
                overrides.append((previous, desired.pop(previous), source))
            desired[relative] = source

    return desired, overrides


def discover_rules(layers: list[Path]) -> dict[str, Path]:
    """Select flat Codex rule files using the usual section precedence."""
    desired: dict[str, Path] = {}
    for layer in layers:
        directory = layer / "rules"
        if directory.is_symlink():
            raise ReconcileError(f"symlinked rule directories are not supported: {directory}")
        if not directory.exists():
            continue
        if not directory.is_dir():
            raise ReconcileError(f"rule root is not a regular directory: {directory}")
        for entry in sorted(directory.iterdir()):
            if entry.is_symlink() or not entry.is_file() or entry.suffix != ".rules":
                raise ReconcileError(f"rules must be regular .rules files: {entry}")
            desired[entry.name] = entry
    return desired


def render_agents(
    config_dir: Path,
    layers: list[Path],
) -> tuple[str, int]:
    sections = [MANAGED_MARKER, "# Global agent instructions"]
    fragments: dict[str, Path] = {}
    fragment_count = 0

    for layer in layers:
        fragments_root = layer / "AGENTS.md.d"
        if not fragments_root.exists():
            continue
        if fragments_root.is_symlink() or not fragments_root.is_dir():
            raise ReconcileError(
                f"config fragment root is not a regular directory: {fragments_root}"
            )

        for fragment in fragments_root.glob("*.md"):
            if fragment.is_symlink():
                raise ReconcileError(f"symlinked config fragments are not supported: {fragment}")
            if not fragment.is_file():
                continue
            fragments[fragment.name] = fragment

    for _, fragment in sorted(fragments.items()):
        try:
            contents = fragment.read_text(encoding="utf-8").strip()
        except (OSError, UnicodeError) as error:
            raise ReconcileError(f"cannot read config fragment: {fragment}: {error}") from error
        sections.append(f"<!-- source: {fragment.relative_to(config_dir).as_posix()} -->")
        if contents:
            sections.append(contents)
        fragment_count += 1

    return "\n\n".join(sections) + "\n", fragment_count


def markdown_destinations(text: str) -> list[str]:
    """Read inline and reference-link paths, including Markdown escapes."""
    destinations = []
    for match in re.finditer(r"\]\(\s*|(?m:^\s*\[[^]\n]+\]:\s*)", text):
        position = match.end()
        angled = text[position:position + 1] == "<"
        position += angled
        depth = 0
        characters = []
        while position < len(text):
            character = text[position]
            position += 1
            if character == "\\" and position < len(text) and text[position] in string.punctuation:
                characters.append(text[position])
                position += 1
                continue
            if character in "\r\n" or (angled and character == ">"):
                break
            if not angled:
                if character.isspace() or (character == ")" and depth == 0):
                    break
                if character == "(":
                    depth += 1
                elif character == ")":
                    depth -= 1
            characters.append(character)
        destinations.append("".join(characters))
    return destinations


def bundle_skill_resources(
    skills: dict[str, Path],
    resources: dict[Path, Path],
    agents_template: str,
    directories: set[Path],
    files: dict[Path, Path],
) -> dict[Path, bytes]:
    """Give each skill its own resource copies, preserving the source tree.

    Expand placeholders relative to the file containing them. Follow Markdown
    links to other known resources so copied guides retain their dependencies.
    Links outside the resource catalog are left alone, including links in
    verbatim snapshots of external documents.
    """
    targets: dict[str, set[Path]] = {"": set(resources)}
    for resource in resources:
        targets[resource.as_posix()] = {resource}
        for parent in resource.parents:
            if parent != Path("."):
                targets.setdefault(parent.as_posix(), set()).add(resource)
    paths = sorted(targets, key=len, reverse=True)
    file_paths = {path.as_posix() for path in resources}
    contents: dict[Path, bytes] = {}

    for name in skills:
        skill_root = Path("skills") / name
        resource_root = skill_root / "resources"
        pending = [(path, None) for path in files if path.is_relative_to(skill_root)]
        copied: set[Path] = set()
        while pending:
            relative, resource = pending.pop()
            source = files[relative]
            original = source.read_bytes()
            if b"\0" in original and relative != GUIDANCE_SKILL:
                continue
            try:
                text = original.decode("utf-8")
            except UnicodeDecodeError as error:
                if relative == GUIDANCE_SKILL:
                    raise ReconcileError(f"cannot read guidance template: {source}: {error}") from error
                continue
            if relative == GUIDANCE_SKILL:
                if text.count(AGENTS_PLACEHOLDER) != 1:
                    raise ReconcileError("Agent_Guidance must contain one {{%_agents_%}} placeholder")
                text = text.replace(AGENTS_PLACEHOLDER, agents_template.rstrip("\n"))

            needed: set[Path] = set()
            for match in re.finditer(re.escape(RESOURCES_PLACEHOLDER), text):
                suffix = re.sub(r"\\([" + re.escape(string.punctuation) + r"])", r"\1", text[match.end():])
                suffix = unquote(suffix)
                if not suffix.startswith("/"):
                    needed.update(resources)
                    continue
                suffix = suffix[1:]
                for path in paths:
                    if not suffix.startswith(path):
                        continue
                    rest = suffix[len(path):]
                    if path not in file_paths:
                        rest = rest.removeprefix("/")
                    if not rest or re.match(r"[\s`\"'>)\]}?#]|[.,;:!](?:\s|$)", rest):
                        needed.update(targets[path])
                        break
                else:
                    raise ReconcileError(f"Unknown resource reference in {source}: {suffix.splitlines()[0]}")

            if resource is not None:
                for link in markdown_destinations(text):
                    # Only catalog-relative paths can add copies. Do not parse
                    # external URLs; even a malformed one is unrelated input.
                    if re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", link) or link.startswith("/"):
                        continue
                    path = link.split("#", 1)[0].split("?", 1)[0]
                    if not path:
                        continue
                    target = os.path.normpath(resource.parent / unquote(path))
                    needed.update(targets.get(target, ()))

            if RESOURCES_PLACEHOLDER in text:
                if resource_root in files:
                    raise ReconcileError(f"Skill resource directory conflicts with a file: {files[resource_root]}")
                directories.add(resource_root)
                local_root = Path(os.path.relpath(resource_root, relative.parent)).as_posix()
                text = text.replace(RESOURCES_PLACEHOLDER, local_root)
            if text.encode("utf-8") != original:
                contents[relative] = text.encode("utf-8")

            for target in sorted(needed - copied):
                destination = resource_root / target
                if destination in files or destination in directories or any(parent in files for parent in destination.parents):
                    raise ReconcileError(f"Bundled resource conflicts with skill contents: {destination}")
                files[destination] = resources[target]
                for parent in destination.parents:
                    if parent != Path("."):
                        directories.add(parent)
                copied.add(target)
                pending.append((destination, target))
    return contents


def effective_codex_dir(codex_dir: Path | None) -> Path:
    if codex_dir is None:
        configured = os.environ.get("CODEX_HOME")
        codex_dir = Path(configured) if configured else Path.home() / ".codex"
    return absolute_path(codex_dir)


def build_render_plan(config_dir: Path, codex_dir: Path | None = None) -> RenderPlan:
    layers = discover_layers(config_dir)
    skills, skill_overrides = discover_skills(layers)
    resources, resource_overrides = discover_resources(layers)
    codex_dir = effective_codex_dir(codex_dir)
    agents_template, fragment_count = render_agents(config_dir, layers)
    agents_template = agents_template.replace(SKILLS_PLACEHOLDER, os.fspath(codex_dir / "skills"))
    agents = agents_template.replace(RESOURCES_PLACEHOLDER, os.fspath(codex_dir / "resources"))
    directories = {Path("skills"), Path("resources"), Path("rules")}
    files: dict[Path, Path] = {Path("rules") / name: source
                                   for name, source in discover_rules(layers).items()}

    for name, source in sorted(skills.items()):
        skill_destination = Path("skills") / name
        directories.add(skill_destination)
        for entry in sorted(
            source.rglob("*"), key=lambda item: item.relative_to(source).as_posix()
        ):
            if entry.is_symlink():
                raise ReconcileError(f"symlinked skill contents are not supported: {entry}")
            destination = skill_destination / entry.relative_to(source)
            if entry.is_dir():
                directories.add(destination)
                continue
            if not entry.is_file():
                raise ReconcileError(f"skill contains a non-regular file: {entry}")
            files[destination] = entry

    for relative, source in sorted(resources.items(), key=lambda item: item[0].as_posix()):
        destination = Path("resources") / relative
        files[destination] = source
        for parent in destination.parents:
            if parent == Path("."):
                break
            directories.add(parent)

    contents = bundle_skill_resources(skills, resources, agents_template, directories, files)

    return RenderPlan(
        layers=layers,
        skills=skills,
        resources=resources,
        skill_overrides=skill_overrides,
        resource_overrides=resource_overrides,
        agents=agents,
        fragment_count=fragment_count,
        directories=directories,
        files=files,
        contents=contents,
    )


def discover_generations(render_dir: Path) -> list[Generation]:
    if render_dir.is_symlink():
        raise ReconcileError(f"render root must not be a symlink: {render_dir}")
    if not render_dir.exists():
        return []
    if not render_dir.is_dir():
        raise ReconcileError(f"render root is not a directory: {render_dir}")

    generations: dict[int, Generation] = {}
    for entry in sorted(render_dir.iterdir(), key=lambda item: item.name):
        if entry.name.startswith("."):
            continue
        if entry.name == "latest":
            if not entry.is_symlink():
                raise ReconcileError(f"latest generation alias is not a symlink: {entry}")
            target = Path(os.readlink(entry))
            if (
                target.is_absolute()
                or len(target.parts) != 1
                or GENERATION_PATTERN.fullmatch(target.name) is None
            ):
                raise ReconcileError(
                    f"latest generation alias must target a local generation: {entry}"
                )
            continue
        match = GENERATION_PATTERN.fullmatch(entry.name)
        if match is None:
            raise ReconcileError(f"unexpected entry in rendered generation root: {entry}")
        try:
            date.fromisoformat(match.group(1))
        except ValueError as error:
            raise ReconcileError(f"generation has an invalid date: {entry}") from error
        if entry.is_symlink() or not entry.is_dir():
            raise ReconcileError(f"generation is not a regular directory: {entry}")
        for generated in (entry, *entry.rglob("*")):
            if generated.is_symlink():
                raise ReconcileError(f"generation must not contain symlinks: {generated}")
            if generated.stat().st_mode & 0o222:
                raise ReconcileError(f"generation contains a writable path: {generated}")

        ordinal = int(match.group(2))
        if ordinal in generations:
            raise ReconcileError(f"duplicate rendered generation ordinal: {ordinal:02d}")
        agents_file = entry / "AGENTS.md"
        if agents_file.is_symlink() or not agents_file.is_file():
            raise ReconcileError(f"generation has no regular AGENTS.md: {entry}")
        try:
            contents = agents_file.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            raise ReconcileError(
                f"cannot read generation instructions: {agents_file}: {error}"
            ) from error
        if not contents.startswith(MANAGED_MARKER):
            raise ReconcileError(f"generation contains unmanaged instructions: {agents_file}")
        generations[ordinal] = Generation(ordinal=ordinal, path=entry)

    return sorted(generations.values(), key=lambda generation: generation.ordinal)


def copy_plan_file(plan: RenderPlan, relative: Path, destination: Path) -> None:
    source = plan.files[relative]
    if relative in plan.contents:
        destination.write_bytes(plan.contents[relative])
        shutil.copystat(source, destination)
    else:
        shutil.copy2(source, destination, follow_symlinks=False)


def rendered_matches(render_dir: Path, plan: RenderPlan) -> bool:
    if not render_dir.is_dir() or render_dir.is_symlink():
        return False

    agents_file = render_dir / "AGENTS.md"
    if not agents_file.is_file() or agents_file.is_symlink():
        return False
    try:
        if agents_file.read_text(encoding="utf-8") != plan.agents:
            return False
    except (OSError, UnicodeError):
        return False

    expected = plan.directories | set(plan.files) | {Path("AGENTS.md")}
    observed: set[Path] = set()
    for entry in render_dir.rglob("*"):
        if entry.is_symlink() or entry.stat().st_mode & 0o222:
            return False
        observed.add(entry.relative_to(render_dir))
    if render_dir.stat().st_mode & 0o222:
        return False
    if observed != expected:
        return False

    for directory in plan.directories:
        if not (render_dir / directory).is_dir():
            return False
    for relative, source in plan.files.items():
        destination = render_dir / relative
        if not destination.is_file():
            return False
        expected_mode = stat.S_IMODE(source.stat().st_mode) & ~0o222
        if stat.S_IMODE(destination.stat().st_mode) != expected_mode:
            return False
        if relative in plan.contents:
            if destination.read_bytes() != plan.contents[relative]:
                return False
        elif not filecmp.cmp(source, destination, shallow=False):
            return False
    return True


def write_rendered_generation(render_dir: Path, ordinal: int, plan: RenderPlan) -> Path:
    render_dir.mkdir(parents=True, exist_ok=True)
    name = f"{date.today().isoformat()}__{ordinal:02d}"
    generation = render_dir / name
    if generation.exists() or generation.is_symlink():
        raise ReconcileError(f"rendered generation already exists: {generation}")

    with tempfile.TemporaryDirectory(
        prefix=f".{name}.",
        dir=render_dir,
    ) as temporary:
        candidate = Path(temporary) / name
        candidate.mkdir()
        (candidate / "AGENTS.md").write_text(plan.agents, encoding="utf-8", newline="\n")

        for directory in sorted(plan.directories, key=lambda item: item.as_posix()):
            (candidate / directory).mkdir(parents=True, exist_ok=True)
        for relative, source in sorted(plan.files.items(), key=lambda item: item[0].as_posix()):
            destination = candidate / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            copy_plan_file(plan, relative, destination)

        for entry in sorted(
            candidate.rglob("*"),
            key=lambda item: (len(item.parts), item.as_posix()),
            reverse=True,
        ):
            entry.chmod(entry.stat().st_mode & ~0o222)
        os.replace(candidate, generation)
        generation.chmod(generation.stat().st_mode & ~0o222)
    return generation


def describe_overrides(plan: RenderPlan) -> None:
    for name, previous, winner in plan.skill_overrides:
        print(f"skill override {name}: {previous} -> {winner}")
    for relative, previous, winner in plan.resource_overrides:
        print(f"resource override {relative.as_posix()}: {previous} -> {winner}")


def render_summary(plan: RenderPlan, generation: Path | None, *, status: str) -> str:
    generation_name = generation.name if generation is not None else "none"
    destination = generation if generation is not None else "none"
    return (
        f"rendered agent-config: layers={len(plan.layers)} "
        f"fragments={plan.fragment_count} skills={len(plan.skills)} "
        f"resources={len(plan.resources)} generation={generation_name} "
        f"status={status} destination={destination}"
    )


def latest_generation_alias_matches(render_dir: Path, generation: Path) -> bool:
    alias = render_dir / "latest"
    return alias.is_symlink() and os.readlink(alias) == generation.name


def update_latest_generation_alias(render_dir: Path, generation: Path) -> None:
    if latest_generation_alias_matches(render_dir, generation):
        return

    alias = render_dir / "latest"
    with tempfile.TemporaryDirectory(prefix=".latest.", dir=render_dir) as temporary:
        candidate = Path(temporary) / "latest"
        candidate.symlink_to(generation.name, target_is_directory=True)
        os.replace(candidate, alias)


def perform_render(render_dir: Path, plan: RenderPlan) -> Path:
    generations = discover_generations(render_dir)
    latest = generations[-1] if generations else None
    if latest is not None and rendered_matches(latest.path, plan):
        update_latest_generation_alias(render_dir, latest.path)
        print(render_summary(plan, latest.path, status="up-to-date"), flush=True)
        return latest.path

    ordinal = latest.ordinal + 1 if latest is not None else 1
    generation = write_rendered_generation(render_dir, ordinal, plan)
    update_latest_generation_alias(render_dir, generation)
    print(render_summary(plan, generation, status="created"), flush=True)
    return generation


def managed_generation_link(
    link: Path,
    render_dir: Path,
    *,
    component: str,
) -> bool:
    if not link.is_symlink():
        return False
    raw_target = Path(os.readlink(link))
    target = absolute_path(raw_target if raw_target.is_absolute() else link.parent / raw_target)
    try:
        relative = target.relative_to(render_dir)
    except ValueError:
        return False
    if len(relative.parts) < 2 or GENERATION_PATTERN.fullmatch(relative.parts[0]) is None:
        return False
    if component == "AGENTS.md":
        return len(relative.parts) == 2 and relative.parts[1] == "AGENTS.md"
    return len(relative.parts) >= 3 and relative.parts[1] == component


def reset_codex_links(codex_dir: Path, legacy_render_dir: Path) -> None:
    if codex_dir.is_symlink() or (codex_dir.exists() and not codex_dir.is_dir()):
        raise ReconcileError(f"Codex path is not a regular directory: {codex_dir}")

    component_roots = {component: codex_dir / component for component in ("skills", "resources")}
    for component, directory in component_roots.items():
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            raise ReconcileError(f"{component} path is not a regular directory: {directory}")

    epoch = int(time.time())
    agents_file = codex_dir / "AGENTS.md"
    agents_backup: Path | None = None
    if agents_file.exists() or agents_file.is_symlink():
        if not agents_file.is_symlink() and not agents_file.is_file():
            raise ReconcileError(f"Codex instructions are not a regular file: {agents_file}")
        agents_backup = codex_dir / f"AGENTS.{epoch}.bak.md"
        if agents_backup.exists() or agents_backup.is_symlink():
            raise ReconcileError(f"backup already exists: {agents_backup}")

    skill_links: list[Path] = []
    skills_root = component_roots["skills"]
    skills_backup: Path | None = None
    if skills_root.is_dir():
        skills_backup = codex_dir / f"skills.{epoch}.bak"
        if skills_backup.exists() or skills_backup.is_symlink():
            raise ReconcileError(f"backup already exists: {skills_backup}")
        skill_links = [entry for entry in skills_root.iterdir() if entry.is_symlink()]

    resource_links: list[Path] = []
    resources_root = component_roots["resources"]
    if resources_root.is_dir():
        for entry in resources_root.iterdir():
            if not entry.is_symlink():
                continue
            raw_target = Path(os.readlink(entry))
            target = absolute_path(
                raw_target if raw_target.is_absolute() else entry.parent / raw_target
            )
            if target == legacy_render_dir or target.is_relative_to(legacy_render_dir):
                resource_links.append(entry)

    if skills_backup is not None:
        try:
            shutil.copytree(skills_root, skills_backup, symlinks=True)
        except (OSError, shutil.Error):
            if skills_backup.is_dir() and not skills_backup.is_symlink():
                shutil.rmtree(skills_backup)
            raise
        print(f"backed up {skills_root} to {skills_backup}")
    if agents_backup is not None:
        agents_file.rename(agents_backup)
        print(f"backed up {agents_file} to {agents_backup}")
    for link in (*skill_links, *resource_links):
        link.unlink()

    print(
        f"reset agent-config: instructions_backed_up={int(agents_backup is not None)} "
        f"skills_backed_up={int(skills_backup is not None)} "
        f"skills_removed={len(skill_links)} resources_removed={len(resource_links)} "
        f"destination={codex_dir}"
    )


def prune_generations(render_dir: Path, codex_dir: Path) -> None:
    generations = discover_generations(render_dir)
    retained = generations[-GENERATION_RETENTION:]
    removable = generations[:-GENERATION_RETENTION]

    if removable:
        latest = generations[-1].path
        if not latest_generation_alias_matches(render_dir, latest):
            raise ReconcileError(
                "latest generation alias must target the newest generation before pruning"
            )

        if codex_dir.is_symlink() or (codex_dir.exists() and not codex_dir.is_dir()):
            raise ReconcileError(f"Codex destination is not a regular directory: {codex_dir}")

        removable_names = {generation.path.name for generation in removable}
        links: list[tuple[Path, str]] = [(codex_dir / "AGENTS.md", "AGENTS.md")]
        for component in ("skills", "resources", "rules"):
            directory = codex_dir / component
            if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
                raise ReconcileError(f"{component} target is not a regular directory: {directory}")
            if directory.is_dir():
                links.extend((entry, component) for entry in directory.iterdir())

        for link, component in links:
            if not managed_generation_link(link, render_dir, component=component):
                continue
            raw_target = Path(os.readlink(link))
            target = absolute_path(
                raw_target if raw_target.is_absolute() else link.parent / raw_target
            )
            generation_name = target.relative_to(render_dir).parts[0]
            if generation_name in removable_names:
                raise ReconcileError(
                    f"refusing to prune active Codex generation: {generation_name} ({link})"
                )

        for generation in removable:
            generation.path.chmod(generation.path.stat().st_mode | 0o200)
            for entry in generation.path.rglob("*"):
                if entry.is_dir():
                    entry.chmod(entry.stat().st_mode | 0o200)
            shutil.rmtree(generation.path)

    latest_name = retained[-1].path.name if retained else "none"
    print(
        f"pruned agent-config: kept={len(retained)} removed={len(removable)} "
        f"latest={latest_name} destination={render_dir}"
    )


def expected_link(source: Path, directory: Path) -> str:
    return os.path.relpath(source, start=directory)


def plan_agents_link(
    codex_dir: Path,
    generation: Path,
    render_dir: Path,
) -> AgentsLinkPlan:
    if codex_dir.is_symlink() or (codex_dir.exists() and not codex_dir.is_dir()):
        raise ReconcileError(f"Codex destination is not a regular directory: {codex_dir}")
    agents_file = codex_dir / "AGENTS.md"
    source = generation / "AGENTS.md"
    relative_target = expected_link(source, codex_dir)
    if agents_file.is_symlink():
        if os.readlink(agents_file) == relative_target:
            return AgentsLinkPlan(agents_file, source, remove_existing=False, unchanged=True)
        if managed_generation_link(agents_file, render_dir, component="AGENTS.md"):
            return AgentsLinkPlan(agents_file, source, remove_existing=True, unchanged=False)
        raise ReconcileError(f"refusing to replace unmanaged Codex instructions: {agents_file}")
    if not agents_file.exists():
        return AgentsLinkPlan(agents_file, source, remove_existing=False, unchanged=False)
    if not agents_file.is_file():
        raise ReconcileError(f"Codex instructions are not a regular file: {agents_file}")
    try:
        current = agents_file.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise ReconcileError(f"cannot read Codex instructions: {agents_file}: {error}") from error
    if current and not current.startswith(MANAGED_MARKER):
        raise ReconcileError(f"refusing to replace unmanaged Codex instructions: {agents_file}")
    return AgentsLinkPlan(agents_file, source, remove_existing=True, unchanged=False)


def plan_component_links(
    codex_dir: Path,
    generation: Path,
    render_dir: Path,
    *,
    component: str,
    populate: bool = True,
) -> LinkPlan:
    directory = codex_dir / component
    if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
        raise ReconcileError(f"{component} target is not a regular directory: {directory}")

    source_root = generation / component
    desired = {
        entry.name: entry for entry in sorted(source_root.iterdir(), key=lambda item: item.name)
    } if populate else {}
    plan = LinkPlan(directory=directory, component=component)

    if directory.is_dir():
        for entry in sorted(directory.iterdir(), key=lambda item: item.name):
            if not managed_generation_link(entry, render_dir, component=component):
                continue
            source = desired.get(entry.name)
            if source is None or os.readlink(entry) != expected_link(source, directory):
                plan.removals.append(entry)

    removals = set(plan.removals)
    for name, source in desired.items():
        link = directory / name
        if link.is_symlink() and os.readlink(link) == expected_link(source, directory):
            plan.unchanged += 1
            continue
        if link in removals:
            plan.links.append((link, source))
            continue
        if link.exists() or link.is_symlink():
            raise ReconcileError(f"refusing to replace unmanaged {component} entry: {link}")
        plan.links.append((link, source))

    return plan


def apply_component_links(plan: LinkPlan) -> None:
    plan.directory.mkdir(parents=True, exist_ok=True)
    for link in plan.removals:
        link.unlink()
        print(f"removed {plan.component} link {link}")
    for link, source in plan.links:
        target = expected_link(source, plan.directory)
        link.symlink_to(target, target_is_directory=source.is_dir())
        print(f"linked {plan.component} {link} -> {target}")


def sync_rendered(
    generation: Path,
    codex_dir: Path,
    render_dir: Path,
    plan: RenderPlan,
    *,
    sync_skills: bool = True,
    instructions_only: bool = False,
) -> None:
    agents_plan = plan_agents_link(codex_dir, generation, render_dir)
    skill_plan = plan_component_links(codex_dir, generation, render_dir,
                                      component="skills", populate=sync_skills)
    resource_plan = plan_component_links(codex_dir, generation, render_dir, component="resources")
    rule_plan = plan_component_links(codex_dir, generation, render_dir, component="rules")

    codex_dir.mkdir(parents=True, exist_ok=True)
    if agents_plan.remove_existing:
        agents_plan.destination.unlink()
        print(f"removed instructions {agents_plan.destination}")
    if not agents_plan.unchanged:
        target = expected_link(agents_plan.source, codex_dir)
        agents_plan.destination.symlink_to(target)
        print(f"linked instructions {agents_plan.destination} -> {target}")

    apply_component_links(skill_plan)
    apply_component_links(resource_plan)
    apply_component_links(rule_plan)
    print(
        f"synced agent-config: layers={len(plan.layers)} "
        f"fragments={plan.fragment_count} skills={len(plan.skills)} "
        f"resources={len(plan.resources)} generation={generation.name} "
        f"agents={'unchanged' if agents_plan.unchanged else 'linked'} "
        f"skills_linked={len(skill_plan.links)} "
        f"skills_unchanged={skill_plan.unchanged} "
        f"resources_linked={len(resource_plan.links)} "
        f"resources_unchanged={resource_plan.unchanged} "
        f"rules_linked={len(rule_plan.links)} rules_unchanged={rule_plan.unchanged} "
        f"skill_destination={'none' if instructions_only else 'skills' if sync_skills else 'marketplace'} "
        f"destination={codex_dir}"
    )


def run(operation: str, config_dir: Path, render_dir: Path, codex_dir: Path | None,
        *, home: Path | None = None,
        skill_marketplace: bool = False, instructions_only: bool = False,
        rules_only: bool = False) -> int:
    config_dir = absolute_path(config_dir)
    render_dir = absolute_path(render_dir)
    if skill_marketplace and operation != "sync":
        raise ReconcileError("--skill-marketplace requires sync")
    if instructions_only and operation != "sync":
        raise ReconcileError("--instructions-only requires sync")
    if skill_marketplace and instructions_only:
        raise ReconcileError("--skill-marketplace and --instructions-only are mutually exclusive")

    if rules_only and (operation != "sync" or skill_marketplace or instructions_only):
        raise ReconcileError("--rules-only requires sync without another sync mode")

    if operation == "reset":
        if codex_dir is None:
            raise ReconcileError("reset requires --codex-dir")
        legacy_render_dir = absolute_path(config_dir.parent / "agent-config-rendered")
        reset_codex_links(absolute_path(codex_dir), legacy_render_dir)
        return 0

    if operation == "prune":
        if codex_dir is None:
            raise ReconcileError("prune requires --codex-dir")
        prune_generations(render_dir, absolute_path(codex_dir))
        return 0

    plan = build_render_plan(config_dir, codex_dir)
    describe_overrides(plan)

    if operation == "check":
        generations = discover_generations(render_dir)
        latest = generations[-1].path if generations else None
        current = (
            latest is not None
            and rendered_matches(latest, plan)
            and latest_generation_alias_matches(render_dir, latest)
        )
        print(render_summary(plan, latest, status="up-to-date" if current else "out-of-date"))
        return 0 if current else 1

    generation = perform_render(render_dir, plan)
    if operation == "sync":
        if codex_dir is None:
            raise ReconcileError("sync requires --codex-dir")
        if rules_only:
            destination = absolute_path(codex_dir)
            if destination.is_symlink() or (destination.exists() and not destination.is_dir()):
                raise ReconcileError(f"Codex destination is not a regular directory: {destination}")
            rule_plan = plan_component_links(destination, generation, render_dir, component="rules")
            apply_component_links(rule_plan)
            print(f"synced rules: linked={len(rule_plan.links)} unchanged={rule_plan.unchanged}")
            return 0
        if skill_marketplace:
            marketplace_home = home if home is not None else Path.home()
            print(json.dumps(populate_marketplace(plan, marketplace_home), indent=2))
        sync_rendered(generation, absolute_path(codex_dir), render_dir, plan,
                      sync_skills=not (skill_marketplace or instructions_only),
                      instructions_only=instructions_only)
    return 0


PLUGIN = "skillset-uoleg"
MARKER = ".managed-skillset.json"


def inventory(root: Path) -> dict[str, str]:
    result = {}
    for path in sorted(root.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"Symlinks are not supported: {path}")
        if path.is_file() and path.relative_to(root).as_posix() != MARKER:
            result[path.relative_to(root).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
    return result


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2) + "\n")


def load_marketplace(path: Path) -> dict:
    """Read the catalog without changing its metadata or unrelated entries."""
    if not path.exists():
        return {"name": "personal", "interface": {"displayName": "Personal"}, "plugins": []}
    catalog = json.loads(path.read_text())
    if not isinstance(catalog, dict) or not isinstance(catalog.get("name"), str) or not catalog["name"].strip():
        raise ValueError(f"Marketplace must have a nonempty name: {path}")
    if not isinstance(catalog.get("plugins"), list):
        raise ValueError(f"Marketplace plugins must be a list: {path}")
    if "interface" in catalog:
        interface = catalog["interface"]
        if not isinstance(interface, dict) or not isinstance(interface.get("displayName"), str) or not interface["displayName"].strip():
            raise ValueError(f"Marketplace interface must have a displayName: {path}")
    names = set()
    for entry in catalog["plugins"]:
        if not isinstance(entry, dict) or not isinstance(entry.get("name"), str) or not entry["name"].strip():
            raise ValueError(f"Marketplace plugin must have a nonempty name: {path}")
        if entry["name"] in names:
            raise ValueError(f"Duplicate marketplace plugin: {entry['name']}")
        names.add(entry["name"])
        source = entry.get("source")
        # Codex accepts both local path strings and source objects. Preserve
        # unrelated entries without resolving their repositories or packages.
        if isinstance(source, str):
            source = {"source": "local", "path": source}
        if not isinstance(source, dict) or source.get("source") not in ("local", "url", "git-subdir", "npm"):
            raise ValueError(f"Invalid marketplace source: {entry['name']}")
        kind = source["source"]
        if kind in ("local", "git-subdir"):
            relative = source.get("path")
            if not isinstance(relative, str) or not relative.startswith("./") or ".." in Path(relative).parts:
                raise ValueError(f"Marketplace source path must stay within its root: {entry['name']}")
        required = "url" if kind in ("url", "git-subdir") else "package" if kind == "npm" else None
        if required and (not isinstance(source.get(required), str) or not source[required].strip()):
            raise ValueError(f"Marketplace source requires {required}: {entry['name']}")
        # Older catalogs may omit policy. Check supplied values without
        # adding defaults or changing an unrelated plugin's install policy.
        if "policy" in entry:
            policy = entry["policy"]
            if not isinstance(policy, dict) or policy.get("installation") not in ("AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"):
                raise ValueError(f"Invalid marketplace installation policy: {entry['name']}")
            if not isinstance(policy.get("authentication"), str) or not policy["authentication"].strip():
                raise ValueError(f"Invalid marketplace authentication policy: {entry['name']}")
        if "category" in entry and (not isinstance(entry["category"], str) or not entry["category"].strip()):
            raise ValueError(f"Invalid marketplace category: {entry['name']}")
    return catalog


def validate_packaged_skills(stage: Path, names: list[str]) -> None:
    """Validate the skill format we package before replacing a working plugin.

    Keep YAML optional for rendering and instructions-only sync on devboxes.
    Marketplace builds provide PyYAML through the agents-sync recipe.
    """
    try:
        import yaml
    except ImportError as error:
        raise ValueError("Marketplace builds require PyYAML; run ajust agents-sync") from error

    allowed = {"name", "description", "license", "allowed-tools", "metadata"}
    for name in names:
        path = stage / "skills" / name / "SKILL.md"
        read_skill_name(path)
        lines = path.read_text().splitlines()
        end = next(i for i in range(1, len(lines)) if lines[i].strip() in {"---", "..."})
        try:
            metadata = yaml.safe_load("\n".join(lines[1:end]))
        except yaml.YAMLError as error:
            raise ValueError(f"Invalid skill YAML: {path}: {error}") from error
        if not isinstance(metadata, dict):
            raise ValueError(f"Skill frontmatter must be a mapping: {path}")
        unexpected = set(metadata) - allowed
        if unexpected:
            raise ValueError(f"Unsupported skill frontmatter keys in {path}: {', '.join(sorted(map(str, unexpected)))}")
        if metadata.get("name") != name or len(name) > 64 or not re.fullmatch(r"[A-Za-z0-9_-]+", name):
            raise ValueError(f"Invalid packaged skill name: {path}")
        description = metadata.get("description")
        if not isinstance(description, str) or not description.strip() or len(description) > 1024:
            raise ValueError(f"Skill description must be a nonempty string of at most 1024 characters: {path}")


def populate_marketplace(plan: RenderPlan, home: Path) -> dict:
    if not plan.skills:
        raise ValueError("Refusing to publish an empty skill collection")
    marketplace = home / ".agents/plugins/marketplace.json"
    destination = home / "plugins" / PLUGIN
    for path in [marketplace, *marketplace.parents, destination, *destination.parents]:
        if path.is_symlink():
            raise ValueError(f"Refusing a symlinked destination: {path}")
    # Validate before touching the installed catalog or generated plugin.
    catalog = load_marketplace(marketplace)
    matches = [p for p in catalog["plugins"] if isinstance(p, dict) and p.get("name") == PLUGIN]
    entry = {
        "name": PLUGIN,
        "source": {"source": "local", "path": f"./plugins/{PLUGIN}"},
        "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
        "category": "Productivity",
    }
    if matches and matches[0]["source"] not in (entry["source"], entry["source"]["path"]):
        raise ValueError("Existing skillset-uoleg entry points elsewhere")
    version = "0.1.0"
    if destination.exists():
        marker = destination / MARKER
        if not marker.is_file() or marker.is_symlink():
            raise ValueError(f"Refusing to replace an unmanaged plugin: {destination}")
        if json.loads(marker.read_text()).get("files") != inventory(destination):
            raise ValueError(f"Generated plugin has local edits: {destination}")
        previous = json.loads((destination / ".codex-plugin/plugin.json").read_text())["version"]
        match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:\+[^\s]+)?", previous)
        if match is None:
            raise ValueError(f"Cannot increment marketplace plugin version: {previous}")
        major, minor, patch = map(int, match.groups())
        version = f"{major}.{minor}.{patch + 1}"
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".skillset-", dir=destination.parent) as temp:
        stage = Path(temp) / PLUGIN
        stage.mkdir()
        for relative, source in plan.files.items():
            target = stage / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            copy_plan_file(plan, relative, target)
        # This renderer owns a skill-only plugin, not a general plugin scaffold.
        manifest = {
            "name": PLUGIN,
            "version": version,
            "description": "Oleg's complete managed skill collection",
            "author": {"name": "uoleg"},
            "skills": "./skills/",
            "interface": {
                "displayName": "Skillset(uoleg)",
                "shortDescription": "Oleg's managed skills",
                "longDescription": "The effective personal and private skills from agent-config, with shared reference files.",
                "developerName": "uoleg",
                "category": "Productivity",
                "capabilities": [],
                "defaultPrompt": "Use my managed skill collection.",
            },
        }
        write_json(stage / ".codex-plugin/plugin.json", manifest)
        validate_packaged_skills(stage, list(plan.skills))
        write_json(stage / MARKER, {"files": inventory(stage)})
        # Preserve the catalog and custom policy on an existing managed entry.
        if not matches:
            catalog["plugins"].append(entry)
        candidate = Path(temp) / "marketplace.json"
        write_json(candidate, catalog)
        marketplace.parent.mkdir(parents=True, exist_ok=True)
        # Stage the catalog on its own filesystem for atomic replacement.
        fd, catalog_temp = tempfile.mkstemp(prefix=".skillset-", dir=marketplace.parent)
        old = Path(temp) / "previous"
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(candidate.read_bytes())
            if destination.exists():
                destination.rename(old)
            try:
                stage.rename(destination)
                os.replace(catalog_temp, marketplace)
            except OSError:
                if destination.exists():
                    shutil.rmtree(destination)
                if old.exists():
                    old.rename(destination)
                raise
        finally:
            Path(catalog_temp).unlink(missing_ok=True)
    return {"plugin": str(destination), "marketplace": str(marketplace), "marketplace_name": catalog["name"], "skills": len(plan.skills), "version": manifest["version"]}



def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("render", "check", "sync", "prune", "reset"))
    parser.add_argument("--config-dir", type=Path, required=True)
    parser.add_argument("--render-dir", type=Path, required=True)
    parser.add_argument("--codex-dir", type=Path)
    parser.add_argument("--home", type=Path, default=Path.home(), help="Marketplace destination home")
    parser.add_argument("--skill-marketplace", action="store_true", help="Populate the personal skill marketplace instead of the skills directory during sync")
    parser.add_argument("--instructions-only", action="store_true", help="Sync instructions and resources, remove managed skill links, and leave marketplaces untouched")
    parser.add_argument("--rules-only", action="store_true", help="Sync only managed Codex rule links")
    arguments = parser.parse_args(argv)

    try:
        return run(
            arguments.operation,
            arguments.config_dir,
            arguments.render_dir,
            arguments.codex_dir,
            home=arguments.home.absolute(),
            skill_marketplace=arguments.skill_marketplace,
            instructions_only=arguments.instructions_only,
            rules_only=arguments.rules_only,
        )
    except (OSError, ReconcileError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
