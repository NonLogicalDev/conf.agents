#!/bin/sh
# Build the Go implementation while preserving the caller's working directory.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
module_dir="$script_dir/../utils/agentbld"
temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/agentbld.XXXXXXXX")
child=

cleanup() {
  rm -f -- "$temporary_dir/agentbld"
  rmdir -- "$temporary_dir"
}

stop() {
  status=$1
  trap - HUP INT TERM
  if [ -n "$child" ]; then
    # A background child may inherit SIGINT as ignored; SIGTERM stops it reliably.
    kill -s TERM "$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
  fi
  exit "$status"
}

run() {
  "$@" &
  child=$!
  status=0
  wait "$child" || status=$?
  child=
  return "$status"
}

trap cleanup EXIT
trap 'stop 129' HUP
trap 'stop 130' INT
trap 'stop 143' TERM

run go -C "$module_dir" build -o "$temporary_dir/agentbld" .
run "$temporary_dir/agentbld" "$@"
