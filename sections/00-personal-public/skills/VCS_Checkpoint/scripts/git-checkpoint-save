#!/bin/sh
set -eu

usage() {
  printf 'Usage: git-checkpoint-save [--role ROLE] [--subject-only] [NOTE]\n' >&2
  exit 2
}

role=agent
note=
has_note=false
subject_only=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --role)
      [ "$#" -ge 2 ] || usage
      role=$2
      case "$role" in
        ''|-*) usage ;;
      esac
      shift
      ;;
    --subject-only)
      subject_only=true
      ;;
    -*)
      usage
      ;;
    *)
      [ "$has_note" = false ] || usage
      note=$1
      has_note=true
      ;;
  esac
  shift
done

if [ -z "$note" ]; then
  note=$(date '+%Y-%d-%mT%H-%M-%S')
fi
subject="checkpoint:$role - $note"

if [ "$subject_only" = true ]; then
  printf '%s\n' "$subject"
else
  exec git commit -m "$subject"
fi
